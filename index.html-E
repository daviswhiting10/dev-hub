<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dev Hub</title>
<script>window.HUB_VERSION="20261024b"; // bump this and the ?v= on every asset below whenever you deploy, so browsers never mix old and new files</script>
<link rel="stylesheet" href="css/style.css?v=20261024b">
<link rel="stylesheet" href="css/exam.css?v=20261024b">
<link rel="stylesheet" href="css/today.css?v=20261024b">
<link rel="stylesheet" href="css/map.css?v=20261024b">
</head>
<body>
<div class="shell">
  <aside class="side noprint">
    <div class="brand"><span class="logo">▲</span> Dev Hub</div>
    <nav id="nav">
      <a href="#/today" data-view="today">Today</a>
      <a href="#/tests" data-view="tests">Tests</a>
      <a href="#/roadmap" data-view="roadmap">Roadmap</a>
      <a href="#/map" data-view="map">Map</a>
      <a href="#/whiteboard" data-view="whiteboard">Whiteboard</a>
      <a href="#/trading" data-view="trading">Trading</a>
    </nav>
    <div class="side-foot">
      <div id="saveState" class="save-state">Saved locally</div>
      <button class="btn small" id="exportBtn">Export backup</button>
      <button class="btn small ghost" id="importBtn">Import</button>
      <input type="file" id="importFile" accept="application/json" hidden>
    </div>
  </aside>
  <main id="view" class="main"><noscript>This app needs JavaScript.</noscript></main>
</div>

<!-- Data (edit these files to change content; no code changes needed) -->
<script src="data/roadmap.js?v=20261024b"></script>
<script src="data/tests.js?v=20261024b"></script>
<script src="data/weather.js?v=20261024b"></script>
<script src="data/playbook.js?v=20261024b"></script>
<script src="data/projects.js?v=20261024b"></script>
<script src="data/learn.js?v=20261024b"></script>
<script src="data/profile.js?v=20261024b"></script>
<script src="data/strategy.js?v=20261024b"></script>
<script src="data/poll.js?v=20261024b"></script>
<script src="data/opps.js?v=20261024b"></script>
<script src="data/venture.js?v=20261024b"></script>
<script src="data/trading.js?v=20261024b"></script>
<!-- App (plain scripts: works from file://) -->
<script src="js/core.js?v=20261024b"></script>
<script src="js/tests.js?v=20261024b"></script>
<script src="js/dashboard.js?v=20261024b"></script>
<script src="js/roadmap.js?v=20261024b"></script>
<script src="js/projects.js?v=20261024b"></script>
<script src="js/playbook.js?v=20261024b"></script>
<script src="js/learn.js?v=20261024b"></script>
<script src="js/poll.js?v=20261024b"></script>
<script src="js/briefing.js?v=20261024b"></script>
<script src="js/resume.js?v=20261024b"></script>
<script src="js/almanac.js?v=20261024b"></script>
<script src="js/venture.js?v=20261024b"></script>
<script src="js/business.js?v=20261024b"></script>
<script src="js/jobs.js?v=20261024b"></script>
<script src="js/opps.js?v=20261024b"></script>
<script src="js/today.js?v=20261024b"></script>
<script src="js/map.js?v=20261024b"></script>
<script src="js/whiteboard.js?v=20261024b"></script>
<script src="js/trading.js?v=20261024b"></script>
<script src="js/ask.js?v=20261024b"></script>
<script src="js/main.js?v=20261024b"></script>
<!-- Question banks q1.js, q2.js, ... are discovered automatically by js/core.js -->
</body>
</html>
